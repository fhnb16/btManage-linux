import { Palette, Button, CheckBox, ComboBox, LineEdit, TextEdit } from "std-widgets.slint";

// One battery: an earbud, the case, or a whole pair of headphones.
export struct CellData {
    // "left", "right", "case" or "main"; picks the outline.
    kind: string,
    label: string,
    // False while the level has not been reported yet.
    known: bool,
    percent: int,
    charging: bool,
    low: bool,
}

export struct OtherDevice {
    name: string,
    // "Connected · Left 90%, Right 70%"
    levels: string,
    // The text of its button, "Connect" or "Disconnect"; empty for none.
    action: string,
}

// Ten segments: earbuds report their charge in steps of 10 %.
component Meter inherits HorizontalLayout {
    in property <int> filled;
    in property <bool> low;

    height: 4px;
    spacing: 2px;

    for index in 10: Rectangle {
        background: index < root.filled
            ? (root.low ? #c42b1c : Palette.accent-background)
            : Palette.foreground.with-alpha(0.16);
    }
}

component Outline inherits Path {
    in property <string> kind;

    width: 32px;
    height: 32px;
    viewbox-width: 32;
    viewbox-height: 32;
    stroke: Palette.foreground.with-alpha(0.6);
    stroke-width: 1.5px;
    commands: kind == "left" ? "M 20 11 L 20 24 A 3 3 0 0 1 14 24 L 14 17.93 A 7 7 0 1 1 20 11 Z"
        : kind == "right" ? "M 12 11 L 12 24 A 3 3 0 0 0 18 24 L 18 17.93 A 7 7 0 1 0 12 11 Z"
        : kind == "case" ? "M 11 6 H 21 A 6 6 0 0 1 27 12 V 20 A 6 6 0 0 1 21 26 H 11 A 6 6 0 0 1 5 20 V 12 A 6 6 0 0 1 11 6 Z M 5 13 H 27 M 15 18 A 1 1 0 1 0 17 18 A 1 1 0 1 0 15 18 Z"
        : "M 7 18 V 15 A 9 9 0 0 1 25 15 V 18 M 6.5 18 H 7.5 A 2.5 2.5 0 0 1 10 20.5 V 24.5 A 2.5 2.5 0 0 1 7.5 27 H 6.5 A 2.5 2.5 0 0 1 4 24.5 V 20.5 A 2.5 2.5 0 0 1 6.5 18 Z M 24.5 18 H 25.5 A 2.5 2.5 0 0 1 28 20.5 V 24.5 A 2.5 2.5 0 0 1 25.5 27 H 24.5 A 2.5 2.5 0 0 1 22 24.5 V 20.5 A 2.5 2.5 0 0 1 24.5 18 Z";
}

component Cell inherits VerticalLayout {
    in property <CellData> data;

    spacing: 8px;
    alignment: start;

    HorizontalLayout {
        alignment: start;
        Outline {
            kind: root.data.kind;
        }
    }

    Text {
        text: root.data.known ? root.data.percent + "%" : "—";
        color: root.data.known ? Palette.foreground : Palette.foreground.with-alpha(0.45);
        font-size: 28px;
    }

    Meter {
        filled: root.data.known ? round(root.data.percent / 10) : 0;
        low: root.data.low;
    }

    Text {
        text: root.data.charging ? root.data.label + " · charging" : root.data.label;
        color: Palette.foreground.with-alpha(0.6);
        font-size: 12px;
    }
}

export component AppWindow inherits Window {
    in property <bool> has-device;
    in property <string> device-name;
    in property <string> device-age;
    in property <[CellData]> cells;
    in property <[OtherDevice]> others;
    in property <string> empty-title;
    in property <string> empty-hint;
    // Set when a newer release exists: "Version 1.2.3 is available".
    in property <string> update-text;
    callback open-update();
    // The button of a device on the list was pressed; its place on the list.
    callback device-action(int);

    // Sharing with other btManage applications on the local network.
    in property <string> share-status;
    // "name · platform · address", one per device heard.
    in property <[string]> share-peers;
    // What was sent and received, newest first.
    in property <[string]> share-history;
    in-out property <bool> share-receive;
    in-out property <string> share-target;
    in-out property <string> share-text;
    in-out property <string> share-file;
    // The code another device types in to pair with this one, "482 913".
    in property <string> share-code;
    in-out property <string> share-pair-code;
    callback share-pair();
    callback share-receive-toggled(bool);
    callback share-pick-peer(int);
    callback share-send-text();
    callback share-send-file();

    // Noise control of the headphones on top, over Apple's accessory protocol:
    // the modes they offer, and the one in effect (-1 while not known).
    in property <[string]> noise-modes;
    in-out property <int> noise-current: -1;
    callback noise-pick(int);

    callback open-console();

    // The panel has one width, like the flyout of the Windows application.
    out property <length> panel-width: 360px;

    title: "btManage";
    width: root.panel-width;
    background: Palette.background;
    default-font-size: 14px;

    VerticalLayout {
        padding: 16px;
        spacing: 16px;
        alignment: start;

        if root.has-device: HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.device-name;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: root.device-age;
                color: Palette.foreground.with-alpha(0.6);
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        if root.has-device: HorizontalLayout {
            spacing: 12px;
            alignment: start;
            // Three equal columns, also when headphones fill only the first.
            for cell in root.cells: Cell {
                data: cell;
                width: (root.panel-width - 2 * 16px - 2 * 12px) / 3;
            }
        }

        if root.has-device && root.noise-modes.length > 0: HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Noise control";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ComboBox {
                model: root.noise-modes;
                current-index <=> root.noise-current;
                selected => {
                    root.noise-pick(self.current-index);
                }
            }
        }

        if root.others.length > 0: VerticalLayout {
            Rectangle {
                height: 1px;
                background: Palette.foreground.with-alpha(0.1);
            }

            for other[index] in root.others: HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: other.name;
                        overflow: elide;
                    }

                    Text {
                        text: other.levels;
                        color: Palette.foreground.with-alpha(0.6);
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                if other.action != "": Button {
                    text: other.action;
                    clicked => {
                        root.device-action(index);
                    }
                }
            }
        }

        if !root.has-device: VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;
            Text {
                text: root.empty-title;
                font-weight: 600;
            }

            Text {
                text: root.empty-hint;
                color: Palette.foreground.with-alpha(0.6);
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        if root.update-text != "": VerticalLayout {
            spacing: 12px;
            Rectangle {
                height: 1px;
                background: Palette.foreground.with-alpha(0.1);
            }

            update-link := TouchArea {
                height: 20px;
                mouse-cursor: pointer;
                clicked => {
                    root.open-update();
                }
                Text {
                    width: 100%;
                    text: root.update-text;
                    vertical-alignment: center;
                    color: update-link.has-hover ? Palette.foreground : Palette.foreground.with-alpha(0.6);
                    font-size: 12px;
                }
            }
        }

        // Files and text to and from other devices with btManage on the same network.
        VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 1px;
                background: Palette.foreground.with-alpha(0.1);
            }

            Text {
                text: "Sharing";
                font-weight: 600;
            }

            Text {
                text: root.share-status;
                color: Palette.foreground.with-alpha(0.6);
                font-size: 12px;
                wrap: word-wrap;
            }

            CheckBox {
                text: "Take files and text from paired devices";
                checked <=> root.share-receive;
                toggled => {
                    root.share-receive-toggled(self.checked);
                }
            }

            // The code of this computer: typed in on another device, it pairs the two.
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Pairing code";
                    color: Palette.foreground.with-alpha(0.6);
                    font-size: 12px;
                }

                Text {
                    text: root.share-code;
                    font-size: 28px;
                    font-weight: 600;
                }

                Text {
                    text: "Type it in on the other device to pair the two. Nothing is encrypted yet";
                    color: Palette.foreground.with-alpha(0.6);
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            for peer[index] in root.share-peers: TouchArea {
                height: 28px;
                mouse-cursor: pointer;
                clicked => {
                    root.share-pick-peer(index);
                }
                Text {
                    width: 100%;
                    text: peer;
                    vertical-alignment: center;
                    overflow: elide;
                    color: parent.has-hover ? Palette.accent-background : Palette.foreground;
                }
            }

            LineEdit {
                placeholder-text: "Address, as ip:port";
                text <=> root.share-target;
            }

            // Pairing with the device above: the code it shows.
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    placeholder-text: "Its pairing code";
                    text <=> root.share-pair-code;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Pair";
                    clicked => {
                        root.share-pair();
                    }
                }
            }

            LineEdit {
                placeholder-text: "Text";
                text <=> root.share-text;
            }

            LineEdit {
                placeholder-text: "Path of a file";
                text <=> root.share-file;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Send text";
                    clicked => {
                        root.share-send-text();
                    }
                }

                Button {
                    text: "Send file";
                    clicked => {
                        root.share-send-file();
                    }
                }
            }

            for line in root.share-history: Text {
                text: line;
                font-size: 12px;
                wrap: word-wrap;
                color: Palette.foreground.with-alpha(0.8);
            }
        }

        VerticalLayout {
            spacing: 12px;
            Rectangle {
                height: 1px;
                background: Palette.foreground.with-alpha(0.1);
            }

            console-link := TouchArea {
                height: 20px;
                mouse-cursor: pointer;
                clicked => {
                    root.open-console();
                }
                Text {
                    width: 100%;
                    text: "Developer console";
                    vertical-alignment: center;
                    color: console-link.has-hover ? Palette.foreground : Palette.foreground.with-alpha(0.6);
                    font-size: 12px;
                }
            }
        }
    }
}

component FieldLabel inherits Text {
    color: Palette.foreground.with-alpha(0.6);
    font-size: 12px;
}

// The developer console: raw traffic with one device. Filled in by src/console.rs.
export component ConsoleWindow inherits Window {
    // "Name  AA:BB:CC:DD:EE:FF", the connected devices first.
    in property <[string]> devices;
    in-out property <int> device-index;
    // 0 GATT, 1 RFCOMM, 2 L2CAP.
    in-out property <int> way-index;
    // "None", then the ready commands of the way.
    in property <[string]> templates;
    in-out property <int> template-index;
    // "2A19 · read, notify", after connecting over GATT.
    in property <[string]> characteristics;
    in-out property <string> target;
    in-out property <string> data;
    in-out property <bool> hex;
    // 0 none, 1 CR, 2 CR LF, 3 LF.
    in-out property <int> ending-index;
    in property <string> status;
    // Newest first.
    in property <string> output;
    callback refresh-devices();
    callback connect();
    callback disconnect();
    callback send();
    callback read();
    callback subscribe();
    callback clear();
    callback way-changed(int);
    callback template-picked(int);
    callback characteristic-picked(int);

    title: "btManage console";
    preferred-width: 640px;
    preferred-height: 720px;
    background: Palette.background;
    default-font-size: 14px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        VerticalLayout {
            spacing: 4px;
            FieldLabel {
                text: "Device";
            }

            HorizontalLayout {
                spacing: 8px;
                ComboBox {
                    model: root.devices;
                    current-index <=> root.device-index;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Refresh";
                    clicked => {
                        root.refresh-devices();
                    }
                }

                ComboBox {
                    model: ["GATT", "RFCOMM", "L2CAP"];
                    current-index <=> root.way-index;
                    selected => {
                        root.way-changed(self.current-index);
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                FieldLabel {
                    text: root.status;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Connect";
                    primary: true;
                    clicked => {
                        root.connect();
                    }
                }

                Button {
                    text: "Disconnect";
                    clicked => {
                        root.disconnect();
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            FieldLabel {
                text: "Ready command";
            }

            ComboBox {
                model: root.templates;
                current-index <=> root.template-index;
                selected => {
                    root.template-picked(self.current-index);
                }
            }
        }

        if root.way-index == 0: VerticalLayout {
            spacing: 4px;
            FieldLabel {
                text: root.characteristics.length > 0 ? "Characteristics of the device" : "Characteristics: listed after connecting";
            }

            if root.characteristics.length > 0: ComboBox {
                model: root.characteristics;
                selected => {
                    root.characteristic-picked(self.current-index);
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            FieldLabel {
                text: root.way-index == 0 ? "Characteristic: 2A19 or a full UUID"
                    : root.way-index == 1 ? "Channel, 1 to 30"
                    : "PSM: 0x1001 for Apple's accessory protocol";
            }

            LineEdit {
                text <=> root.target;
            }
        }

        VerticalLayout {
            spacing: 4px;
            FieldLabel {
                text: "Data";
            }

            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.data;
                    placeholder-text: "Text, or bytes such as 04 00 0F with Hex on";
                    horizontal-stretch: 1;
                    accepted => {
                        root.send();
                    }
                }

                CheckBox {
                    text: "Hex";
                    checked <=> root.hex;
                }

                ComboBox {
                    model: ["No ending", "CR", "CR LF", "LF"];
                    current-index <=> root.ending-index;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: "Send";
                clicked => {
                    root.send();
                }
            }

            if root.way-index == 0: Button {
                text: "Read";
                clicked => {
                    root.read();
                }
            }

            if root.way-index == 0: Button {
                text: "Subscribe";
                clicked => {
                    root.subscribe();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Exchange";
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                text: "Clear";
                clicked => {
                    root.clear();
                }
            }
        }

        TextEdit {
            text: root.output;
            read-only: true;
            wrap: word-wrap;
            font-size: 12px;
            vertical-stretch: 1;
        }
    }
}
